# Copiar a .env y completar. .env no se commitea.
MENTIA_DB_NAME=mentia
MENTIA_DB_USER=mentia
MENTIA_DB_PASSWORD=
MENTIA_DB_URL=jdbc:postgresql://localhost:5432/mentia

# Secreto HS256 del JWT. Mínimo 32 caracteres, aleatorio.
MENTIA_JWT_SECRET=

# Key de la API de Anthropic (opcional). Vacía = la IA queda deshabilitada y la API funciona igual.
# La API se corre con ./mvnw, que NO lee este archivo: exportarla en la terminal o en la
# run configuration del IDE. Usar keys distintas para dev y prod. Nunca commitearla.
ANTHROPIC_API_KEY=
